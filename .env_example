# Copy this file to .env and fill in your values (see "Configure your league" in the README).
# No spaces or quotes around the values.

# The number after "leagueId=" in your league's web address.
# You can also paste the whole address here (then YEAR can be left as is).
LEAGUE_ID=your_league_id_here

# The year the season started, e.g. 2025 for the 2025-26 season
YEAR=your_league_year_here

# Only needed for private leagues: leave both empty if your league is public.
# ESPN_S2 is a long string; SWID looks like {XXXXXXXX-XXXX-...}. Copy both exactly as shown.
ESPN_S2=your_espn_s2_here
SWID=your_swid_here
